generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DebtType {
  CREDIT_CARD
  PERSONAL_LOAN
  EMI
  BNPL
  OTHER
}

enum RateType {
  FLAT
  REDUCING
}

model Debt {
  id        String   @id @default(uuid())
  userId    String
  name      String
  type      DebtType
  principal Decimal? @db.Decimal(14, 2)
  currentBalance Decimal @db.Decimal(14, 2)
  rateType   RateType @default(REDUCING)
  interestRateAnnual Decimal @db.Decimal(6, 3)
  minPayment Decimal? @db.Decimal(14, 2)
  dueDay     Int?     // day of month, 1-31
  tenureMonths Int?      // remaining months, for loans/EMI
  startDate    DateTime?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}

// A "should I take this loan" check — stores the terms the user confirmed and
// the computed true-cost verdict, never the raw offer document itself.
model LoanOfferCheck {
  id                       String   @id @default(uuid())
  userId                   String
  lenderName               String?
  loanType                 DebtType @default(OTHER)
  principal                Decimal  @db.Decimal(14, 2)
  tenureMonths             Int
  rateType                 RateType @default(REDUCING)
  quotedRateAnnual         Decimal  @db.Decimal(6, 3)
  processingFeeValue       Decimal  @db.Decimal(10, 2)
  otherUpfrontFees         Decimal  @db.Decimal(10, 2) @default(0)
  prepaymentPenaltyPercent Decimal? @db.Decimal(5, 2)
  teaserRateAnnual         Decimal? @db.Decimal(6, 3)
  teaserMonths             Int?
  postTeaserRateAnnual     Decimal? @db.Decimal(6, 3)
  trueApr                  Decimal  @db.Decimal(6, 3)
  tier                     String   // GREAT | FAIR | HIGH_COST | PREDATORY
  redFlags                 Json
  createdAt                DateTime @default(now())
  @@index([userId])
}

// A committed-to avalanche/snowball plan, snapshotted at creation so progress
// can be judged against the original trajectory even if debts are later
// renamed, deleted, or a new plan replaces this one.
model TrackedPayoffPlan {
  id                 String   @id @default(uuid())
  userId             String
  strategy           String   // "avalanche" | "snowball"
  extraMonthlyBudget Decimal  @db.Decimal(14, 2)
  status             String   @default("ACTIVE") // ACTIVE | COMPLETED | ABANDONED
  startDate          DateTime @default(now())
  totalMonths        Int
  totalInterestPaid  Decimal  @db.Decimal(14, 2)
  totalPaid          Decimal  @db.Decimal(14, 2)
  payoffOrder        Json     // string[] of debt ids, in payoff order
  monthlySummary     Json     // MonthSummary[] snapshot from simulateMultiDebtPayoff
  debtNames          Json     // { [debtId]: name } snapshot
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@index([userId])
}
