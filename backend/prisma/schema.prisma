generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DebtType {
  CREDIT_CARD
  PERSONAL_LOAN
  EMI
  BNPL
  OTHER
}

model Debt {
  id        String   @id @default(uuid())
  userId    String
  name      String
  type      DebtType
  principal Decimal? @db.Decimal(14, 2)
  currentBalance Decimal @db.Decimal(14, 2)
  interestRateAnnual Decimal @db.Decimal(6, 3)
  minPayment Decimal? @db.Decimal(14, 2)
  dueDay     Int?     // day of month, 1-31
  tenureMonths Int?      // remaining months, for loans/EMI
  startDate    DateTime?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}
